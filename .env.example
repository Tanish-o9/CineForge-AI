# Django & Database Settings
DJANGO_SECRET_KEY=django-insecure-cineforge-key-12345
DJANGO_DEBUG=True
DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/cineforge
REDIS_URL=redis://redis:6379/0

# Cloud AI Model APIs (Remove mock stubs and run on cloud models by setting keys)
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# S3 object storage settings
AWS_ACCESS_KEY_ID=your_aws_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=cineforge-assets
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
