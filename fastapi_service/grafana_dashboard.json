{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Pipeline Stage Durations (Seconds)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(cineforge_pipeline_stage_duration_seconds_sum[1m]) / rate(cineforge_pipeline_stage_duration_seconds_count[1m])",
          "legendFormat": "{{stage_name}} average duration",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Stage Execution Rates (Success / Fail / Retry)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (stage_name, status) (increase(cineforge_pipeline_stage_total[5m]))",
          "legendFormat": "{{stage_name}} - {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Celery Queue Task Depth",
      "type": "gauge",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "cineforge_queue_depth",
          "legendFormat": "Tasks Pending",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 4,
      "title": "Active GPU Workers",
      "type": "gauge",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "cineforge_active_gpu_workers",
          "legendFormat": "Workers active",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 5,
      "title": "External API Call Rate (Cost Proxy)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (service_name) (rate(cineforge_external_api_calls_total[5m]))",
          "legendFormat": "{{service_name}} calls/sec",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["cineforge", "monitoring"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "CineForge AI Generation Pipeline Health Dashboard",
  "version": 1
}
